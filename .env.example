# Public app URL used for OAuth callbacks
APP_URL=https://your-hostinger-domain.example

# Session encryption (use a long random value in production)
AUTH_SECRET=

# Google sign-in OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alpaca PAPER OAuth app
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=

# Safe global execution defaults
PAPER_EXECUTION_ENABLED=false
AUTO_EXECUTION_ENABLED=false
TRADING_KILL_SWITCH=false

# Optional legacy/server Alpaca PAPER credentials
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Optional OpenAI research
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
